#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu
# Runs inside the disposable live-build chroot, never directly on a host.
test -e /usr/share/abs/bootstrap/install.sh
# Debian live-build owns the final APT sources; do not add duplicate entries.
# Debian's live launcher works around a stale build fstab. Keep it empty in
# this image instead; Calamares creates the installed fstab from partitions.
: > /etc/fstab
# No machine identity or random seed is shipped to subsequent boots.
: > /etc/machine-id
rm -f /var/lib/dbus/machine-id /var/lib/systemd/random-seed
systemctl enable NetworkManager.service lightdm.service
