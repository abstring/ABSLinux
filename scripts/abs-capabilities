#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Read-only capability facts. No identifiers, network details or serial numbers."""
import argparse
import json
from pathlib import Path
import subprocess

def read(path):
    try:
        return path.read_text().strip()
    except OSError:
        return ""

def detect(sys=Path('/sys'), properties=None):
    if properties is None:
        properties = []
        for dev in sorted((sys / 'class/input').glob('event*')):
            result = subprocess.run(['udevadm', 'info', '--query=property', '--path', str(dev)],
                                    capture_output=True, text=True, check=False)
            properties.append(dict(line.split('=', 1) for line in result.stdout.splitlines() if '=' in line))
    def prop(key):
        return any(p.get(key) == '1' for p in properties)
    return dict(
        battery=any(read(p / 'type') == 'Battery' and read(p / 'scope') != 'Device'
                    and read(p / 'present') != '0' for p in (sys / 'class/power_supply').glob('*')),
        touchscreen=prop('ID_INPUT_TOUCHSCREEN'), touchpad=prop('ID_INPUT_TOUCHPAD'),
        trackpoint=prop('ID_INPUT_POINTINGSTICK'),
        # SW_TABLET_MODE is bit 1 of the kernel input switch capability bitmap.
        tablet_mode=any(int(read(p) or '0', 16) & 2 != 0
                        for p in (sys / 'class/input').glob('event*/device/capabilities/sw')),
        rotation_sensor=any(list(p.glob('in_accel_*_raw')) for p in (sys / 'bus/iio/devices').glob('iio:device*')),
        hardware_buttons=prop('ID_INPUT_KEY'),
        multi_monitor=sum(read(p) == 'connected' for p in (sys / 'class/drm').glob('*/status')) > 1,
        bluetooth=any((sys / 'class/bluetooth').glob('hci*')))

if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.parse_args()
    print(json.dumps(detect(), sort_keys=True, indent=2))
