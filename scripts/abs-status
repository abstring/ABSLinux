#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
import os
from pathlib import Path
import subprocess
import sys

def run(*args):
    result = subprocess.run(args, text=True, capture_output=True, check=False, timeout=3)
    return result.stdout.strip()

def read(path):
    try:
        return path.read_text().strip()
    except OSError:
        return ''

kind = sys.argv[1]
if os.environ.get('BLOCK_BUTTON') == '1':
    commands = {'network':['nm-connection-editor'], 'audio':['pavucontrol'],
                'bluetooth':['blueman-manager'], 'screenshot':['flameshot','gui']}
    if kind in commands:
        subprocess.Popen(commands[kind], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
try:
    if kind == 'battery':
        batteries = [p for p in Path('/sys/class/power_supply').glob('*')
                     if read(p / 'type') == 'Battery' and read(p / 'scope') != 'Device'
                     and read(p / 'present') != '0']
        # Show each battery independently; do not average unequal packs.
        print(' | '.join('BAT ' + (read(p / 'capacity') or '?') + '% ' + read(p / 'status') for p in batteries))
    elif kind == 'bluetooth':
        print('BT on' if 'Powered: yes' in run('bluetoothctl', 'show') else 'BT off')
    elif kind == 'network':
        print('Net ' + run('nmcli', '-t', '-f', 'STATE', 'general'))
    elif kind == 'audio':
        print('Audio ' + run('pactl', 'get-sink-volume', '@DEFAULT_SINK@').split('/')[1].strip())
    elif kind == 'screenshot':
        print('Screenshot')
except (OSError, subprocess.TimeoutExpired, IndexError):
    print(kind + ' unavailable')
